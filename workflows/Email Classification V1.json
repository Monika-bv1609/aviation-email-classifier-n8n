    {
      "parameters": {
        "jsCode": "// Get the current email\nconst email = $input.item.json;\n\n// Required fields\nconst requiredFields = [\n  \"message_id\",\n  \"provider\",\n  \"sender_email\",\n  \"subject\",\n  \"body\"\n];\n\n// Validate each field\nfor (const field of requiredFields) {\n  if (\n    email[field] === undefined ||\n    email[field] === null ||\n    email[field].toString().trim() === \"\"\n  ) {\n    throw new Error(`${field} is missing or empty.`);\n  }\n}\n\n// Validation successful\nreturn [\n  {\n    json: email\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        -16
      ],
      "id": "e7996ffc-7679-4533-bc94-1e113cba8618",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI email classifier for an aviation company. Respond ONLY with valid JSON containing category, confidence, and reason.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Classify this email.\\n\\nSubject: {{$json.subject}}\\n\\nBody: {{$json.body}}\"\n    }\n  ],\n  \"temperature\": 0,\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        656,
        288
      ],
      "id": "2c179cfa-0c48-4814-bc22-1c2179578658",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const email = $('Code in JavaScript').first().json;\n\nconst response = $input.item.json;\nconst ai = JSON.parse(response.choices[0].message.content);\n\nreturn [\n  {\n    json: {\n      message_id: email.message_id,\n      provider: email.provider,\n      sender_email: email.sender_email,\n      subject: email.subject,\n      body: email.body,\n\n      category: ai.category,\n      confidence: ai.confidence,\n      reason: ai.reason\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        288
      ],
      "id": "63a16104-84a5-41fa-932e-a0298e8607a3",
      "name": "Parse AI Response"
    },
    {
      "parameters": {
        "jsCode": "// Read the parsed email + AI classification\nconst email = $input.item.json;\n\n// Business rule\nconst CONFIDENCE_THRESHOLD = 0.80;\n\n// Determine processing status\nlet processingStatus;\n\nif (email.confidence >= CONFIDENCE_THRESHOLD) {\n  processingStatus = \"AUTO_PROCESSED\";\n} else {\n  processingStatus = \"PENDING_REVIEW\";\n}\n\n// Return updated object\nreturn [\n  {\n    json: {\n      ...email,\n      processing_status: processingStatus\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        288
      ],
      "id": "effce1af-2f16-4873-ae09-a6215fe9a1c3",
